# RetailOps AI local configuration template.
# Never commit real credentials or secrets.

GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=
GCS_LOCATION=us-central1
GCS_LANDING_PREFIX=landing/m5/v1

BQ_LOCATION=us-central1
BQ_RAW_DATASET=retailops_raw
BQ_DBT_DATASET=retailops

# First learned forecasting model.
ML_TRAIN_LOOKBACK_DAYS=180
ML_NUM_BOOST_ROUND=300
ML_USE_BQ_STORAGE_API=false
ML_WRITE_BIGQUERY=false
ML_ARTIFACT_DIR=artifacts/models/lightgbm_global_v1
