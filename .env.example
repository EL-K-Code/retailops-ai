# RetailOps AI local configuration template.
# Never commit real credentials or secrets.

GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=
GCS_LOCATION=us-central1
GCS_LANDING_PREFIX=landing/m5/v1

BQ_LOCATION=us-central1
BQ_RAW_DATASET=retailops_raw
BQ_DBT_DATASET=retailops

# First learned forecasting model.
ML_TRAIN_LOOKBACK_DAYS=180
ML_NUM_BOOST_ROUND=300
ML_USE_BQ_STORAGE_API=false
ML_WRITE_BIGQUERY=false
ML_ARTIFACT_DIR=artifacts/models/lightgbm_global_v1

# V3 MLOps / Vertex AI.
VERTEX_REGION=us-central1
VERTEX_ARTIFACT_REPOSITORY=retailops-ml
VERTEX_TRAINING_IMAGE_URI=
VERTEX_SERVING_IMAGE_URI=
VERTEX_OUTPUT_ROOT=
VERTEX_SERVICE_ACCOUNT=
VERTEX_MACHINE_TYPE=n1-standard-4
VERTEX_TRAIN_LOOKBACK_DAYS=90
VERTEX_NUM_BOOST_ROUND=100
VERTEX_MAX_MEAN_RMSSE=0.952306197699721
VERTEX_EXPERIMENT=retailops-demand-forecasting
VERTEX_MODEL_DISPLAY_NAME=retailops-lightgbm-global
VERTEX_MODEL_ID=retailops-lightgbm-global
VERTEX_MODEL_ALIAS=candidate
